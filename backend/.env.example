# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file.

ENVIRONMENT=development

# REQUIRED. Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-your-own-generated-secret

# Comma-separated list of frontend origins allowed to call this API.
# The Vite dev server in rewind-ai-react/ runs on port 3000 (see vite.config.ts).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# How long a login token stays valid (minutes).
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional. Leave commented out to use the default SQLite file backend/rewind.db
# DATABASE_URL=sqlite:///./rewind.db
